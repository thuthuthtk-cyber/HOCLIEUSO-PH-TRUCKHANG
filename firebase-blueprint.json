  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Hồ sơ giáo viên, tổ trưởng và quản trị viên."
    },
    "/materials/{materialId}": {
      "schema": {
        "$ref": "#/entities/LearningMaterial"
      },
      "description": "Kho học liệu số của Trường Tiểu học Quang Hưng - Phân hiệu Trực Khang."
    },
    "/public_games/{shareCode}": {
      "schema": {
        "$ref": "#/entities/PublicGame"
      },
      "description": "Trò chơi AI công khai cho học sinh truy cập bằng mã chia sẻ 20 ký tự."
    },
    "/ai_game_quotas/{quotaId}": {
      "schema": {
        "$ref": "#/entities/AiGameQuota"
      },
      "description": "Giới hạn số lượt tạo trò chơi AI theo ngày của giáo viên."
    },
    "/exams/{examId}": {
      "schema": {
        "$ref": "#/entities/ExamRecord"
      },
      "description": "Kho đề kiểm tra định kì kèm Ma trận, Bản đặc tả và Đáp án do giáo viên tạo bằng AI."
    },
    "/subjects/{subjectId}": {
      "schema": {
        "$ref": "#/entities/SubjectItem"
      },
      "description": "Danh mục môn học."
    },
    "/departments/{deptId}": {
      "schema": {
        "$ref": "#/entities/DepartmentItem"
      },
      "description": "Danh sách tổ khối chuyên môn."
    }
  }
}
